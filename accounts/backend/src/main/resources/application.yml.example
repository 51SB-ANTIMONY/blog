server:
  port: 9000
  servlet:
    session:
      cookie:
        # 같은 localhost에서 실행하는 blog 서버의 JSESSIONID와 섞이지 않도록 이름을 바꾼다.
        name: ACCOUNTS_SESSION

spring:
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    defer-datasource-initialization: true
  datasource:
    url: jdbc:h2:mem:accounts
    username: sa
  h2:
    console:
      enabled: true
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: <Google Client ID>
            client-secret: <Google Client Secret>
            scope:
              - email
              - profile

accounts:
  # 인가 서버의 주소. 토큰의 iss 클레임과 설정 문서(/.well-known/openid-configuration)에 들어간다.
  issuer: http://localhost:9000
  clients:
    blog:
      client-secret: <blog 클라이언트의 Client Secret. blog 서버 설정과 같은 값>
      redirect-uri: http://localhost:8080/login/oauth2/code/accounts
      post-logout-redirect-uri: http://localhost:8080/
