server:
  port: 9000
  # Next.js(accounts 화면)가 요청을 넘겨줄 때 붙이는 X-Forwarded-Host/Proto를 보고, 사용자가 접속한 주소 기준으로 리다이렉트 주소를 만든다.
  forward-headers-strategy: framework
  servlet:
    session:
      cookie:
        # 같은 localhost에서 실행하는 blog 서버의 JSESSIONID와 섞이지 않도록 이름을 바꾼다.
        name: ACCOUNTS_SESSION

spring:
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    defer-datasource-initialization: true
  datasource:
    url: jdbc:h2:mem:accounts
    username: sa
  h2:
    console:
      enabled: true
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: <Google Client ID>
            client-secret: <Google Client Secret>
            scope:
              - email
              - profile

accounts:
  # 인가 서버의 주소(사용자와 앱이 접속하는 주소). 토큰의 iss 클레임과 설정 문서에 들어간다.
  # 로컬에서는 accounts 화면(Next.js)의 주소다. Next.js가 인가 서버 주소들을 이 서버로 넘겨준다.
  issuer: http://localhost:3001
  clients:
    blog:
      client-secret: <blog 클라이언트의 Client Secret. blog 서버 설정과 같은 값>
      redirect-uri: http://localhost:8080/login/oauth2/code/accounts
      post-logout-redirect-uri: http://localhost:8080/
  remember-me:
    key: <로그인 상태 유지 쿠키 서명 키. 임의의 긴 문자열>
