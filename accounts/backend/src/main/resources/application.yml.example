server:
  port: 9000
  servlet:
    session:
      cookie:
        # 같은 localhost에서 실행하는 blog 서버의 JSESSIONID와 섞이지 않도록 이름을 바꾼다.
        name: ACCOUNTS_SESSION

spring:
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    defer-datasource-initialization: true
  datasource:
    url: jdbc:h2:mem:accounts
    username: sa
  h2:
    console:
      enabled: true
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: <Google Client ID>
            client-secret: <Google Client Secret>
            scope:
              - email
              - profile

jwt:
  issuer: <발급자 문자열>
  secret_key: <blog와 같은 값. Base64로 인코딩한 32바이트 이상의 난수>

accounts:
  # Google 로그인 성공 후 토큰을 붙여 보낼 주소 (1-2 단계 임시 동작)
  login-success-redirect-url: http://localhost:8080/articles
