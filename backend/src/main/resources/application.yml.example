server:
  # blog 화면(Next.js, 3000)이 요청을 넘겨줄 때 붙이는 X-Forwarded-Host를 보고,
  # 사용자가 접속한 주소(3000) 기준으로 리다이렉트 주소와 redirect_uri를 만든다.
  forward-headers-strategy: framework
  servlet:
    session:
      cookie:
        # 같은 localhost에서 실행하는 accounts(ACCOUNTS_SESSION)와 구별하기 위해 이름을 정한다.
        name: BLOG_SESSION

spring:
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
    defer-datasource-initialization: true
  datasource:
    url: jdbc:h2:mem:testdb
    username: sa
  h2:
    console:
      enabled: true

# 로그인을 맡기는 인가 서버(accounts). blog는 여기에 등록된 OIDC 클라이언트다.
accounts:
  # 브라우저가 가는 주소 (accounts 화면). ID 토큰의 iss와 같아야 한다.
  issuer: http://localhost:3001
  # blog 서버가 직접 부르는 주소 (토큰 교환, 서명 공개 키). 없으면 issuer를 쓴다.
  backchannel-uri: http://localhost:9000
  client-id: blog
  # accounts의 accounts.clients.blog.client-secret과 같은 값
  client-secret: <blog client secret>
